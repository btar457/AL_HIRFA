rules_version = '2';

// قواعد أمان Firebase Storage لتطبيق AL-HIRFA — تغطي كل مسارات الرفع الفعلية
// في الكود (auth_service.dart: uploadProfilePhoto، product_service.dart:
// uploadProductImages). لا Cloud Functions في هذا المشروع، لذا هذه القواعد
// هي خط الدفاع الحقيقي الوحيد على مستوى Storage، بنفس مبدأ firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // auth_service.dart: uploadProfilePhoto — profile_photos/{uid}/{timestamp}.jpg
    // القراءة عامة لأي مسجَّل دخوله (نفس مبدأ قراءة users/{uid} في firestore.rules:
    // photoUrl معروض لأي طرف آخر عبر التطبيق)، الكتابة لصاحب الحساب فقط.
    match /profile_photos/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && uid == request.auth.uid && isValidImage();
      allow delete: if false;
    }

    // product_service.dart: uploadImages — products/{artisanUid}/{productId}/{timestamp}_{i}.jpg
    // segment artisanUid في المسار نفسه يضمن أن الحرفي يكتب فقط تحت مجلده
    // الخاص، بغضّ النظر عن قيمة productId.
    match /products/{artisanUid}/{productId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && artisanUid == request.auth.uid && isValidImage();
      allow delete: if false;
    }

    // أي مسار آخر غير مذكور أعلاه: رفض افتراضي كامل.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
